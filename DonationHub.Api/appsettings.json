{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=DonationHubDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Jwt": {
    "Issuer": "DonationHub",
    "Audience": "DonationHubUsers",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "SeedAdmin": {
    "Email": "admin@donationhub.com",
    "FullName": "Administrator",
    "PreferredLanguage": "en"
  },
  "DonationOptions": {
    "MinimumDonationAmount": 1.00,
    "MaximumDonationAmount": 10000.00,
    "PendingTimeoutMinutes": 30,
    "DefaultCurrency": "USD"
  },

  "SeedDevUsers": {
    "CampaignManager": {
      "Email": "manager@donationhub.com",
      "FullName": "Test Campaign Manager"
    },
    "Donor": {
      "Email": "donor@donationhub.com",
      "FullName": "Test Donor"
    }
  }
}